            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dell XPS 13\",\n  \"description\": \"Intel Core Ultra 7\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"basePrice\": 1299,\n  \"status\": \"ACTIVE\",\n  \"stockStatus\": \"IN_STOCK\"\n}" },
