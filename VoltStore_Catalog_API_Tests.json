    {
      "name": "4. Products — update (EP-CAT-02)",
      "item": [
        {
          "name": "Update product (move to second category) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated product', () => {",
                  "    pm.expect(body.productId).to.eql(pm.collectionVariables.get('productId'));",
                  "    pm.expect(body.title).to.eql('MacBook Pro 16 (2026)');",
                  "    pm.expect(body.description).to.eql('M4 Max, 48GB RAM, 2TB SSD');",
                  "    pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('secondCategoryId'));",
                  "    pm.expect(body.basePrice).to.eql(3999.5);",
                  "});",
                  "pm.test('New products are NOT_ACTIVE and OUT_OF_STOCK', () => {",
                  "    pm.expect(body.status).to.eql('NOT_ACTIVE');",
                  "    pm.expect(body.stockStatus).to.eql('OUT_OF_STOCK');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \" MacBook Pro 16 (2026) \",\n  \"description\": \"M4 Max, 48GB RAM, 2TB SSD\",\n  \"categoryId\": \"{{secondCategoryId}}\",\n  \"basePrice\": 3999.50\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["catalog", "products", "{{productId}}"] }
          }
        },
        {
          "name": "Update with status/stockStatus in body → 200 (fields unchanged)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status and stockStatus are not editable here', () => {",
                  "    pm.expect(body.status).to.eql('NOT_ACTIVE');",
                  "    pm.expect(body.stockStatus).to.eql('OUT_OF_STOCK');",
                  "});"
                ]
              }
            }
