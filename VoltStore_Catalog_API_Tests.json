    {
      "name": "3. Products — create (EP-CAT-01)",
      "item": [
        {
          "name": "Create product → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns only productId', () => {",
                  "    pm.expect(body.productId).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(Object.keys(body)).to.eql(['productId']);",
                  "});",
                  "pm.collectionVariables.set('productId', body.productId);",
                  "// A ProductCreated event is published to Kafka: check the catalog-service log for",
                  "// 'Received ProductCreated: key=<productId>, partition=..., offset=...'"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"MacBook Pro 16\",\n  \"description\": \"M3 Max, 36GB RAM, 1TB SSD\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"basePrice\": 3499.99\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/products", "host": ["{{baseUrl}}"], "path": ["catalog", "products"] }
          }
        },
        {
          "name": "Create with status/stockStatus in body → 201 (fields ignored)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "// The stored status is checked by 'Update product → 200' further down: it is still NOT_ACTIVE"
