{
  "info": {
    "name": "VoltStore Catalog Service API",
    "description": "Tests for the Catalog Service endpoints implemented so far (EP-CAT-01, 02, 06, 07, 08), in the spec's /catalog/... routes. Run the whole collection in order with the Collection Runner: requests store IDs in collection variables for the following ones. Every error response is checked for the shared RFC 9457 problem shape by the collection-level test script.\n\nbaseUrl: http://localhost:8081 when the service runs in Compose (host port 8081). If localhost:8081 is taken by another program on your machine (e.g. the IIT EUSAProcess agent), use http://[::1]:8081.\n\nNo auth headers yet: security is added in task 12.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "categoryName", "value": "", "type": "string" },
    { "key": "secondCategoryId", "value": "", "type": "string" },
    { "key": "secondCategoryName", "value": "", "type": "string" },
    { "key": "emptyCategoryId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "unknownId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Unique suffix per run, so category names do not collide with data from earlier runs",
          "if (!pm.collectionVariables.get('runId')) {",
          "    pm.collectionVariables.set('runId', Date.now().toString());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared error format (RFC 9457 ProblemDetail) for every 4xx/5xx response",
          "if (pm.response.code >= 400 && pm.response.text().length > 0) {",
          "    pm.test('Error body has the shared problem shape', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.include.all.keys('type', 'title', 'status', 'detail', 'timestamp', 'service');",
          "        pm.expect(body.status).to.eql(pm.response.code);",
          "        pm.expect(body.service).to.eql('catalog-service');",
          "        pm.expect(body.type).to.match(/^https:\\/\\/voltstore\\.com\\/errors\\//);",
          "        pm.expect(body).to.not.have.property('trace');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Readiness probe is UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Readiness is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health/readiness", "host": ["{{baseUrl}}"], "path": ["actuator", "health", "readiness"] }
          }
        }
      ]
    },
    {
      "name": "1. Categories — create (EP-CAT-06)",
      "item": [
        {
          "name": "Create category → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('categoryName', 'Laptops ' + pm.collectionVariables.get('runId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns categoryId (not id) and the trimmed name', () => {",
                  "    pm.expect(body.categoryId).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(body).to.not.have.property('id');",
                  "    pm.expect(body.name).to.eql(pm.collectionVariables.get('categoryName'));",
                  "});",
                  "pm.collectionVariables.set('categoryId', body.categoryId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"  {{categoryName}}  \"\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/categories", "host": ["{{baseUrl}}"], "path": ["catalog", "categories"] }
          }
        },
        {
          "name": "Create duplicate name (other case + spaces) → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Detail explains the conflict', () => pm.expect(pm.response.json().detail).to.eql('Category name already in use'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \" LAPTOPS {{runId}} \"\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/categories", "host": ["{{baseUrl}}"], "path": ["catalog", "categories"] }
          }
        },
        {
          "name": "Create blank name → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Field error for name', () => pm.expect(pm.response.json().errors.name).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"   \"\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/categories", "host": ["{{baseUrl}}"], "path": ["catalog", "categories"] }
          }
        },
        {
          "name": "Create name longer than 100 chars → 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('longName', 'x'.repeat(101));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Field error for name', () => pm.expect(pm.response.json().errors).to.have.property('name'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{longName}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/categories", "host": ["{{baseUrl}}"], "path": ["catalog", "categories"] }
          }
        },
        {
          "name": "Create second category → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('secondCategoryName', 'Phones ' + pm.collectionVariables.get('runId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('secondCategoryId', pm.response.json().categoryId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{secondCategoryName}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/catalog/categories", "host": ["{{baseUrl}}"], "path": ["catalog", "categories"] }
          }
        }
      ]
    },
