      "put" : {
        "description" : "Role: CATALOG_MANAGER. Status and stock status are not editable here. Stores a `ProductUpdated` event.",
        "operationId" : "updateProduct",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProductRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProductResponse"
                }
              }
            },
            "description" : "The updated product"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Invalid fields"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CATALOG_MANAGER"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "No product with this ID"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The product was changed by someone else at the same time"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The category does not exist"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Update a product (EP-CAT-02)",
        "tags" : [ "Products" ]
      }
    },
    "/catalog/products/{id}/status" : {
      "patch" : {
        "description" : "Role: CATALOG_MANAGER. Activation first asks Inventory whether the product is ready (stock item and packaging data exist). Stores a `ProductUpdated` event when the status changes.",
        "operationId" : "changeStatus",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProductStatusRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Status set"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Missing or invalid status"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CATALOG_MANAGER"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "No product with this ID"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The product was changed by someone else at the same time"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ActivationRejectedProblem"
                }
              }
            },
            "description" : "Inventory says the product is not ready for activation"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Inventory cannot be reached; try again later",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait before retrying",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Activate or deactivate a product (EP-CAT-03)",
        "tags" : [ "Products" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ActivationRejectedProblem" : {
        "type" : "object",
        "description" : "The product cannot be activated (422)",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "reason" : {
            "type" : "string",
            "description" : "Inventory's code, e.g. `packaging_data_missing` or `stock_item_not_found`"
          },
          "service" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "reason", "status", "title", "type" ]
      },
      "CategoryRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "name" ]
      },
      "CategoryResponse" : {
        "type" : "object",
        "properties" : {
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "categoryId", "name" ]
      },
      "CreateProductResponse" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "productId" ]
      },
      "PageResponseCategoryResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CategoryResponse"
            }
          },
