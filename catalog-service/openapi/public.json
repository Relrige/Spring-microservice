    "/catalog/products" : {
      "get" : {
        "description" : "Role: none, or CATALOG_MANAGER or INVENTORY_WORKER. Anonymous callers and every other role see only ACTIVE products, and `status` is ignored for them. A CATALOG_MANAGER or INVENTORY_WORKER sees ACTIVE and NOT_ACTIVE products and may filter by `status`.",
        "operationId" : "browseProducts",
        "parameters" : [ {
          "in" : "query",
          "name" : "search",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "categoryId",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "Comma-separated product IDs, at most 100 distinct. Only these products are returned (still filtered by visibility and the other parameters); paging is unchanged, so send `size=100` to get up to 100 products in one page.",
          "in" : "query",
          "name" : "ids",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          }
        }, {
          "in" : "query",
          "name" : "minPrice",
          "required" : false,
          "schema" : {
            "type" : "number",
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "maxPrice",
          "required" : false,
          "schema" : {
            "type" : "number",
            "minimum" : 0
          }
        }, {
          "description" : "`title` or `basePrice`, optionally followed by `,asc` or `,desc`",
          "example" : "basePrice,desc",
          "in" : "query",
          "name" : "sortBy",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Applied for CATALOG_MANAGER and INVENTORY_WORKER only",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "NOT_ACTIVE" ]
          }
        }, {
          "description" : "Zero-based page number, default 0",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 21474836,
            "minimum" : 0
          }
        }, {
          "description" : "Page size, default 20, at most 100",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0,
            "maximum" : 100
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseProductSummaryResponse"
                }
              }
            },
            "description" : "One page of products"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Invalid query parameters, or minPrice greater than maxPrice"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        }, { } ],
        "summary" : "Search products (EP-CAT-04)",
        "tags" : [ "Products" ]
      },
      "post" : {
        "description" : "Role: CATALOG_MANAGER. The product is created NOT_ACTIVE.",
        "operationId" : "createProduct",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProductRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CreateProductResponse"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Invalid fields"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CATALOG_MANAGER"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The category does not exist"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Create a product (EP-CAT-01)",
        "tags" : [ "Products" ]
      }
    },
    "/catalog/products/{id}" : {
      "get" : {
        "description" : "Role: none, or CATALOG_MANAGER or INVENTORY_WORKER. These two roles see products of any status; for every other caller a NOT_ACTIVE product answers the same 404 as a missing one.",
        "operationId" : "getProduct",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
