{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Catalog API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Through the API Gateway"
  } ],
  "paths" : {
    "/catalog/products/batch-get" : {
      "get" : {
        "description" : "Comma-separated `ids`, at most 100 distinct. Products of any status; unknown IDs are left out of the answer, and each product appears once.",
        "operationId" : "batchGetProducts",
        "parameters" : [ {
          "in" : "query",
          "name" : "ids",
          "required" : true,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/BatchProductResponse"
                  }
                }
              }
            },
            "description" : "The products found"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Missing, empty or malformed `ids`, or more than 100"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Missing or invalid internal token"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "internalToken" : [ ]
        } ],
        "summary" : "Look up several products by ID (EP-CAT-09)",
        "tags" : [ "Products" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "BatchProductResponse" : {
        "type" : "object",
        "properties" : {
          "basePrice" : {
            "type" : "number"
          },
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "NOT_ACTIVE" ]
          },
          "stockStatus" : {
            "type" : "string",
            "enum" : [ "IN_STOCK", "OUT_OF_STOCK" ]
          },
          "title" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "basePrice", "productId", "status", "stockStatus", "title", "version" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 problem details",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string",
            "description" : "Name of the service that answered"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Error kind: `https://voltstore.com/errors/<kind>`"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "ValidationProblem" : {
        "type" : "object",
        "description" : "A malformed request or broken field rules (400)",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Field or parameter name to its messages"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "status", "title", "type" ]
      }
    },
    "securitySchemes" : {
      "internalToken" : {
        "description" : "Shared service-to-service token",
        "in" : "header",
        "name" : "X-Internal-Token",
        "type" : "apiKey"
      }
    }
  }
}