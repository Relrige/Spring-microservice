POSTGRES_DB=catalog-service
POSTGRES_USER=catalog-service
POSTGRES_PASSWORD=catalog-service
SPRING_DATASOURCE_URL=jdbc:postgresql://catalog-service-postgres:5432/catalog-service
SPRING_DATASOURCE_USERNAME=catalog-service
SPRING_DATASOURCE_PASSWORD=catalog-service
# Kafka broker: kafka:9092 inside Compose; use localhost:9094 when running the service from the IDE
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
