POSTGRES_DB=auth-service
POSTGRES_USER=auth-service
POSTGRES_PASSWORD=auth-service
SPRING_DATASOURCE_URL=jdbc:postgresql://auth-service-postgres:5432/auth-service
SPRING_DATASOURCE_USERNAME=auth-service
SPRING_DATASOURCE_PASSWORD=auth-service
# HS256 key shared with the API Gateway; must be at least 32 bytes.
AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes-long
AUTH_ADMIN_EMAIL=admin@voltstore.com
AUTH_ADMIN_PASSWORD=admin-local-password
# Shared secret proving that a request comes from another VoltStore service (sent as X-Internal-Token).
# Must be identical in every service and at least 32 characters.
AUTH_INTERNAL_TOKEN=change-me-local-internal-token-at-least-32-chars
