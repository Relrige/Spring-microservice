POSTGRES_DB=order-service
POSTGRES_USER=order-service
POSTGRES_PASSWORD=order-service
SPRING_DATASOURCE_URL=jdbc:postgresql://order-service-postgres:5432/order-service
SPRING_DATASOURCE_USERNAME=order-service
SPRING_DATASOURCE_PASSWORD=order-service
# Shared secret proving that a request comes from another VoltStore service (sent as X-Internal-Token).
# Must be identical in every service (AUTH_INTERNAL_TOKEN in auth-service) and at least 32 characters.
INTERNAL_TOKEN=change-me-local-internal-token-at-least-32-chars
# The services Order calls; inside Compose the container port 8080, from the IDE the host ports (the defaults)
CATALOG_SERVICE_URL=http://catalog-service:8080
INVENTORY_SERVICE_URL=http://inventory-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
DELIVERY_SERVICE_URL=http://delivery-service:8080
# Optional tuning (defaults shown). The Payment read timeout must be at least 6s (checked at startup): Payment's own
# worst case, with its gateway timeout and one repeat, is about 4.5 s
# PAYMENT_READ_TIMEOUT=8s
# CATALOG_READ_TIMEOUT=3s
# INVENTORY_READ_TIMEOUT=3s
# DELIVERY_READ_TIMEOUT=3s
# Checkout (optional, defaults shown): how long a new order may be paid, and the carriers a customer may choose
# (comma-separated; Delivery must support each)
# ORDER_PAYMENT_WINDOW=15m
# ORDER_CARRIERS=NOVA_POSHTA
# How often interrupted cancellations are retried (optional, default 1m)
# ORDER_CANCELLATION_RETRY_INTERVAL=1m
# Payment-window expiry job (optional): how often it runs, and how long after the window it waits; the grace
# must be longer than PAYMENT_READ_TIMEOUT (checked at startup)
# ORDER_EXPIRY_INTERVAL=1m
# ORDER_EXPIRY_GRACE=30s
# Kafka broker: kafka:9092 inside Compose; use localhost:9094 when running the service from the IDE
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Order-owned topic for OrderPlaced, OrderPaid, OrderShipped, OrderCancelled (optional, this is the default)
ORDER_EVENTS_TOPIC=order.order-events
