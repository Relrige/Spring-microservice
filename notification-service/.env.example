POSTGRES_DB=notification-service
POSTGRES_USER=notification-service
POSTGRES_PASSWORD=notification-service
SPRING_DATASOURCE_URL=jdbc:postgresql://notification-service-postgres:5432/notification-service
SPRING_DATASOURCE_USERNAME=notification-service
SPRING_DATASOURCE_PASSWORD=notification-service
# Kafka broker: kafka:9092 inside Compose; use localhost:9094 when running the service from the IDE
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Consumed topics (Notification only subscribes); optional, these are the defaults
ORDER_EVENTS_TOPIC=order.order-events
DELIVERY_EVENTS_TOPIC=delivery.shipment-events
