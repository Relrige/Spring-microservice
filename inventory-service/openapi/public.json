{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Inventory API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Through the API Gateway"
  } ],
  "paths" : {
    "/inventory/stock" : {
      "get" : {
        "description" : "Role: INVENTORY_WORKER.",
        "operationId" : "listStock",
        "parameters" : [ {
          "description" : "Only items whose packaging is (or is not) configured",
          "in" : "query",
          "name" : "packagingConfigured",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Case-insensitive part of the product title; `%` and `_` match literally. Blank means no filter; rows without a copied title never match",
          "in" : "query",
          "name" : "search",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only items whose product has this Catalog status",
          "in" : "query",
          "name" : "productStatus",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "NOT_ACTIVE" ]
          }
        }, {
          "description" : "Zero-based page number",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "description" : "Page size, at most 100",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        }, {
          "description" : "`productId`, `title`, `availableQuantity` or `reservedQuantity`, optionally followed by `,asc` or `,desc`; default `productId`. Rows without a title come last",
          "example" : "availableQuantity,desc",
          "in" : "query",
          "name" : "sortBy",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseStockBalanceResponse"
                }
              }
            },
            "description" : "One page of stock balances"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Invalid query parameters"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not an INVENTORY_WORKER"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "List stock balances (EP-INV-01)",
        "tags" : [ "Stock" ]
      }
    },
    "/inventory/stock/{productId}/adjust" : {
      "post" : {
        "description" : "Role: INVENTORY_WORKER. A positive `delta` restocks, a negative one writes off. The first adjustment of a product creates its stock item after Catalog confirms the product exists.",
        "operationId" : "adjustStock",
        "parameters" : [ {
          "in" : "path",
          "name" : "productId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AdjustStockRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdjustStockResponse"
                }
              }
            },
            "description" : "Adjusted"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Missing, zero or non-integer `delta`"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not an INVENTORY_WORKER"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The product does not exist in the catalog"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A write-off would make the available stock negative"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Catalog cannot be reached; nothing changed",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait before retrying",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Restock or write off (EP-INV-02)",
        "tags" : [ "Stock" ]
      }
    },
    "/inventory/stock/{productId}/packaging" : {
      "put" : {
        "description" : "Role: INVENTORY_WORKER. Creates the stock item (with zero stock) if it does not exist yet, after Catalog confirms the product exists.",
        "operationId" : "setPackaging",
        "parameters" : [ {
          "in" : "path",
          "name" : "productId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetPackagingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Saved"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "A value is missing, not positive or not an integer"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not an INVENTORY_WORKER"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The product does not exist in the catalog"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Catalog cannot be reached; nothing changed",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait before retrying",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Set packaging dimensions (EP-INV-03)",
        "tags" : [ "Stock" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AdjustStockRequest" : {
        "type" : "object",
        "properties" : {
          "delta" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "delta" ]
      },
      "AdjustStockResponse" : {
        "type" : "object",
        "properties" : {
          "newAvailableQuantity" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "newAvailableQuantity" ]
      },
      "PageResponseStockBalanceResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/StockBalanceResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "content", "page", "size", "totalElements" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 problem details",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string",
            "description" : "Name of the service that answered"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Error kind: `https://voltstore.com/errors/<kind>`"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "SetPackagingRequest" : {
        "type" : "object",
        "properties" : {
          "grossWeightGrams" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          },
          "heightCm" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          },
          "lengthCm" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          },
          "widthCm" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "grossWeightGrams", "heightCm", "lengthCm", "widthCm" ]
      },
      "StockBalanceResponse" : {
        "type" : "object",
        "properties" : {
          "availableQuantity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "packagingConfigured" : {
            "type" : "boolean"
          },
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "productStatus" : {
            "type" : "string",
            "description" : "Catalog's product status; missing until copied",
            "enum" : [ "ACTIVE", "NOT_ACTIVE" ]
          },
          "reservedQuantity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string",
            "description" : "Catalog's product title; missing until copied"
          },
          "totalQuantity" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "availableQuantity", "packagingConfigured", "productId", "reservedQuantity", "totalQuantity" ]
      },
      "ValidationProblem" : {
        "type" : "object",
        "description" : "A malformed request or broken field rules (400)",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Field or parameter name to its messages"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "status", "title", "type" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "JWT from POST /auth/login",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}