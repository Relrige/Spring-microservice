POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service
POSTGRES_PASSWORD=inventory-service
SPRING_DATASOURCE_URL=jdbc:postgresql://inventory-service-postgres:5432/inventory-service
SPRING_DATASOURCE_USERNAME=inventory-service
SPRING_DATASOURCE_PASSWORD=inventory-service
# Kafka broker: kafka:9092 inside Compose; use localhost:9094 when running the service from the IDE
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Catalog-owned topic with ProductCreated (Inventory only subscribes); optional, this is the default
CATALOG_PRODUCT_EVENTS_TOPIC=catalog.product-events
# Catalog Service base URL for the product existence check (adjust/packaging of a product without a StockItem).
# Inside Compose the container port 8080; from the IDE use http://localhost:8081 (Catalog's host port)
CATALOG_SERVICE_URL=http://catalog-service:8080
# Optional tuning of that call (defaults shown): timeouts and one retry for connection errors, timeouts and 5xx
# CATALOG_CONNECT_TIMEOUT=2s
# CATALOG_READ_TIMEOUT=3s
# CATALOG_MAX_RETRIES=1
# CATALOG_RETRY_DELAY=300ms
# Shared secret proving that a request comes from another VoltStore service (sent as X-Internal-Token).
# Must be identical in every service (AUTH_INTERNAL_TOKEN in auth-service) and at least 32 characters.
INTERNAL_TOKEN=change-me-local-internal-token-at-least-32-chars
