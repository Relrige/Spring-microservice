{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Customer API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Through the API Gateway"
  } ],
  "paths" : {
    "/customers/cart" : {
      "delete" : {
        "description" : "Role: CUSTOMER. Idempotent; answers `[]`.",
        "operationId" : "clearCart",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CartItemResponse"
                  }
                }
              }
            },
            "description" : "The empty cart"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CUSTOMER"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Clear my cart (EP-CUST-09)",
        "tags" : [ "Cart" ]
      },
      "get" : {
        "description" : "Role: CUSTOMER. An empty or never-created cart is `[]`.",
        "operationId" : "getCart",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CartItemResponse"
                  }
                }
              }
            },
            "description" : "The cart, ordered by product ID"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CUSTOMER"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Get my cart (EP-CUST-03)",
        "tags" : [ "Cart" ]
      },
      "put" : {
        "description" : "Role: CUSTOMER. Idempotent; `items` may be empty. Cart rules: at most 10 distinct products, quantity 1 to 10 per product.",
        "operationId" : "replaceCart",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CartItemsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CartItemResponse"
                  }
                }
              }
            },
            "description" : "The new cart"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description" : "Malformed request or item"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not a CUSTOMER"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CartRuleProblem"
                }
              }
            },
            "description" : "A cart rule is broken, or a product is listed twice; the cart is unchanged"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Replace my cart (EP-CUST-07)",
        "tags" : [ "Cart" ]
      }
    },
    "/customers/cart/items" : {
