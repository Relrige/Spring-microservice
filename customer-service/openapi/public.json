  "components" : {
    "schemas" : {
      "AddCartItemRequest" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "CartItemResponse" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "CartItemsRequest" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CartItemsRequestItem"
            }
          }
        },
        "required" : [ "items" ]
      },
      "CartItemsRequestItem" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "CartRuleProblem" : {
        "type" : "object",
        "description" : "The request breaks a cart rule; the cart is unchanged (422)",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "maxProducts" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "TOO_MANY_PRODUCTS: the limit"
          },
          "maxQuantity" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "QUANTITY_LIMIT_EXCEEDED: the limit per product"
          },
          "productIds" : {
            "type" : "array",
            "description" : "QUANTITY_LIMIT_EXCEEDED, DUPLICATE_PRODUCT: the products concerned, sorted",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "resultingProductCount" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "TOO_MANY_PRODUCTS: distinct products the cart would contain"
          },
          "service" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "violation" : {
            "type" : "string",
            "enum" : [ "TOO_MANY_PRODUCTS", "QUANTITY_LIMIT_EXCEEDED", "DUPLICATE_PRODUCT" ]
          }
        },
        "required" : [ "status", "title", "type", "violation" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 problem details",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string",
            "description" : "Name of the service that answered"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Error kind: `https://voltstore.com/errors/<kind>`"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "ProfileRequest" : {
        "type" : "object",
        "properties" : {
          "defaultAddress" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "phone" : {
            "type" : "string",
            "pattern" : "^\\+[1-9]\\d{7,14}$"
          }
        },
        "required" : [ "firstName", "lastName", "phone" ]
      },
      "ProfileResponse" : {
        "type" : "object",
        "properties" : {
          "defaultAddress" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "lastName" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          }
        }
      },
      "SetCartItemQuantityRequest" : {
        "type" : "object",
        "properties" : {
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        },
        "required" : [ "quantity" ]
      },
      "ValidationProblem" : {
        "type" : "object",
        "description" : "A malformed request or broken field rules (400)",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Field or parameter name to its messages"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "service" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "status", "title", "type" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "JWT from POST /auth/login",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}