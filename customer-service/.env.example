POSTGRES_DB=customer-service
POSTGRES_USER=customer-service
POSTGRES_PASSWORD=customer-service
SPRING_DATASOURCE_URL=jdbc:postgresql://customer-service-postgres:5432/customer-service
SPRING_DATASOURCE_USERNAME=customer-service
SPRING_DATASOURCE_PASSWORD=customer-service
# Kafka broker: kafka:9092 inside Compose; use localhost:9094 when running the service from the IDE
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Order-owned topic with OrderPaid (Customer only subscribes); optional, this is the default
# (provisional name until Order Service publishes)
ORDER_EVENTS_TOPIC=order.order-events
