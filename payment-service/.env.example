POSTGRES_DB=payment-service
POSTGRES_USER=payment-service
POSTGRES_PASSWORD=payment-service
SPRING_DATASOURCE_URL=jdbc:postgresql://payment-service-postgres:5432/payment-service
SPRING_DATASOURCE_USERNAME=payment-service
SPRING_DATASOURCE_PASSWORD=payment-service# Shared secret proving that a request comes from another VoltStore service (sent as X-Internal-Token).
# Must be identical in every service (AUTH_INTERNAL_TOKEN in auth-service) and at least 32 characters.
INTERNAL_TOKEN=change-me-local-internal-token-at-least-32-chars
# Payment provider adapter; only "mock" exists (optional, this is the default)
PAYMENT_GATEWAY_PROVIDER=mock
# Optional tuning of the gateway call (defaults shown): time limit of one call, and how often a call with an
# unknown outcome is repeated with the same idempotency key. Order Service's read timeout must exceed the worst case
# PAYMENT_GATEWAY_TIMEOUT=2s
# PAYMENT_GATEWAY_MAX_RETRIES=1
# PAYMENT_GATEWAY_RETRY_DELAY=300ms
