# HS256 key used to verify user JWTs. Must be identical to AUTH_JWT_SECRET in auth-service/.env (at least 32 bytes).
AUTH_JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes-long
# Upstream services. Inside Compose a service is reached by its Compose name on the container port 8080
# (published host ports such as 8086 only exist on the host). Kubernetes uses the Service ports instead
# (see k8s/gateway/app-config.yaml).
GATEWAY_UPSTREAMS_AUTH=http://auth-service:8080
GATEWAY_UPSTREAMS_CATALOG=http://catalog-service:8080
GATEWAY_UPSTREAMS_INVENTORY=http://inventory-service:8080
GATEWAY_UPSTREAMS_CUSTOMER=http://customer-service:8080
GATEWAY_UPSTREAMS_DELIVERY=http://delivery-service:8080
GATEWAY_UPSTREAMS_ORDER=http://order-service:8080
