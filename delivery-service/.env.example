POSTGRES_DB=delivery-service
POSTGRES_USER=delivery-service
POSTGRES_PASSWORD=delivery-service
SPRING_DATASOURCE_URL=jdbc:postgresql://delivery-service-postgres:5432/delivery-service
SPRING_DATASOURCE_USERNAME=delivery-service
SPRING_DATASOURCE_PASSWORD=delivery-service
# Shared secret proving that a request comes from another VoltStore service (sent and checked as X-Internal-Token).
# Must be identical in every service (AUTH_INTERNAL_TOKEN in auth-service and Catalog) and at least 32 characters.
AUTH_INTERNAL_TOKEN=change-me-local-internal-token-at-least-32-chars
